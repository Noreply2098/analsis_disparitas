# Salin ke .streamlit/secrets.toml untuk pengembangan lokal (berkas itu di-ignore Git).
# Di Streamlit Community Cloud: App settings -> Secrets, lalu tempel isi seperti ini.

# Database PostgreSQL (Supabase / Neon / Railway, dsb.). Bila dikosongkan, aplikasi
# memakai SQLite lokal yang HILANG saat server restart di hosting.
# Ganti SEMUA bagian huruf besar dengan nilai asli (jangan sisakan tulisan contoh atau kurung []).
# Password sebaiknya hanya huruf dan angka; karakter khusus (@ # / ? %) merusak URL.
# Supabase: pakai string "Session pooler" (host *.pooler.supabase.com, user postgres.KODE_PROYEK),
# karena koneksi langsung hanya IPv6 dan tidak terjangkau dari Streamlit Cloud.
DATABASE_URL = "postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Opsional, sementara saat memecahkan masalah koneksi: tampilkan galat teknis di layar.
# DEBUG_DB = "true"

# Opsional. "true" = siapa pun boleh mendaftar tanpa kode undangan.
# Bawaan (kosong/false) = pendaftaran wajib kode undangan dari administrator.
# REGISTRASI_TERBUKA = "false"

# ---- Email untuk fitur Lupa Password (opsional) ----------------------------
# Bila SMTP_HOST kosong, kode reset dibuat oleh administrator (menu Kelola Pengguna).
# Contoh Gmail: gunakan "App Password" (bukan password Gmail biasa).
# SMTP_HOST = "smtp.gmail.com"
# SMTP_PORT = "587"
# SMTP_USER = "akun-anda@gmail.com"
# SMTP_PASSWORD = "app-password-16-karakter"
# SMTP_FROM = "akun-anda@gmail.com"
# SMTP_SECURITY = "starttls"   # starttls (587) | ssl (465) | none
